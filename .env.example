# Cổng server (Render tự set biến PORT, ở máy thì mặc định 3000)
PORT=3000

# --- Khoá mặc định (tuỳ chọn) ---
# Để trống thì mỗi người dùng tự nhập khoá trên giao diện.
# Nếu điền, người dùng dùng được ngay mà không cần khoá riêng — nhưng mọi site
# sẽ deploy vào tài khoản của bạn, và bạn chịu quota.

# --- Netlify (mặc định, không cần git) ---
# Personal access token: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_TOKEN=

# --- Render (cần git, nên phải có thêm GitHub token) ---
# GitHub personal access token, scope `repo` (classic), hoặc fine-grained với
# Contents: Read and write + Administration: Read and write để tạo repo mới
GITHUB_TOKEN=

# Render API key: https://dashboard.render.com/settings#api-keys
RENDER_API_KEY=
